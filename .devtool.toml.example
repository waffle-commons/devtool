# RFC 012: Specialized Multi-Model Routing — task-specific model selection
# RFC 017: Multi-provider LLM routing (Ollama + OpenAI-compatible APIs)
# See: specs/RFCs/RFC_012_MultiModels_Routing.md
# See: specs/RFCs/RFC_017_Cloud_ready.md

[inference]
# Global inference defaults (optional; can be overridden per model route)
show_thoughts = true
request_timeout = 300
# RFC 016: Vector index backend selection
index_backend = "faiss"  # or "linear" for pure-Python fallback (no numpy/faiss required)

[inference.default]
# Default provider for all routes if not explicitly specified
provider = "ollama"
endpoint = "http://localhost:11434"
keep_alive = "10m"

# ============================================================================
# RFC 012: Per-purpose context windows and output token limits
# ============================================================================
# Uncomment to customize. All values are OPTIONAL; defaults shown below.
#
# [ollama]
# # Per-purpose context window sizes (in tokens)
# # These control how much previous conversation history is retained per task
# num_ctx_fast   = 4096     # commit messages: small context sufficient
# num_ctx_coding = 8192     # testgen/docgen: medium context for file analysis
# num_ctx_review = 12288    # code review/sec-audit: larger context for full review
# num_ctx        = 8192     # fallback context window for other purposes
#
# # Per-purpose max output token limits (controls response length)
# num_predict_fast    = 512     # commit messages: short, punchy output
# num_predict_coding  = 4096    # testgen/docgen: longer structured output
# num_predict_review  = 4096    # code review: capped at reasonable length
# num_predict_default = 4096    # fallback max output tokens
#
# # How long to keep model loaded in VRAM after last request (reduces reload latency)
# keep_alive = "10m"
#
# # Display model thinking tokens in output (RFC 010)
# show_thoughts = true

# ============================================================================
# EXAMPLE 1: Local Ollama (backward compatible - existing setup)
# ============================================================================
# [models]
# default   = "gemma3n:e4b"
# coding    = "qwen3-coder:latest"
# fast      = "qwen3.5:0.8b"
# review    = "qwen3-coder:latest"
# embedding = "nomic-embed-text:latest"

# ============================================================================
# EXAMPLE 2: Remote Ollama + Local Embedding
# ============================================================================
# [inference.default]
# provider = "ollama"
# endpoint = "http://192.168.1.100:11434"  # Remote Ollama server
# keep_alive = "10m"

# [models]
# default   = "gemma3n:e4b"
# coding    = "qwen3-coder:latest"
# fast      = "qwen3.5:0.8b"
# review    = "qwen3-coder:latest"
# embedding = "nomic-embed-text:latest"

# ============================================================================
# EXAMPLE 3: OpenAI-compatible API (e.g., vLLM, text-generation-webui)
# ============================================================================
# [inference.default]
# provider = "openai"
# endpoint = "http://localhost:8000"
# api_key = "ENV:OPENAI_API_KEY"  # Read from environment variable for security

# [models]
# default   = "meta-llama/Llama-2-7b-chat"
# coding    = "meta-llama/CodeLlama-34b-Instruct"
# fast      = "mistral-7b-instruct"
# review    = "meta-llama/CodeLlama-34b-Instruct"
# embedding = "sentence-transformers/all-minilm-l6-v2"

# ============================================================================
# EXAMPLE 4: Mixed providers (OpenAI for chat, local Ollama for embedding)
# ============================================================================
# [inference.default]
# provider = "openai"
# endpoint = "https://api.openai.com/v1"
# api_key = "ENV:OPENAI_API_KEY"

# [inference.embedding]
# provider = "ollama"
# endpoint = "http://localhost:11434"
# keep_alive = "10m"

# [models]
# default   = "gpt-4-turbo"
# coding    = "gpt-4-turbo"
# fast      = "gpt-3.5-turbo"
# review    = "gpt-4-turbo"
# embedding = "nomic-embed-text:latest"

# ============================================================================
# ACTUAL CONFIG: Uncomment and customize one of the examples above
# ============================================================================
#
# [models] section routes tasks to specialized models:
#   - default   = Used by repo-architect, rag-ask, and as fallback for other purposes
#   - coding    = Used by testgen and docgen
#   - fast      = Used by commit messages and first-pass sec-audit analysis
#   - review    = Used by pre-review and sec-audit detailed review
#   - embedding = Used by RAG indexing and vector search
#
# If a specialized model key is missing, it falls back to 'default' model.
# Each value can be a simple string ("model-name") or a full provider dict (RFC 017).
#

[inference.default]
provider = "ollama"
endpoint = "http://localhost:11434"
keep_alive = "10m"

[models]
default   = "gemma3n:e4b"
coding    = "qwen3-coder:latest"
fast      = "qwen3.5:0.8b"
review    = "qwen3-coder:latest"
embedding = "nomic-embed-text:latest"
